{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Worker availability",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [{
        "expr": "up{job=~\"cicd-worker.*|cicd-api\"}",
        "legendFormat": "{{service}}",
        "refId": "A",
        "instant": true
      }],
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "title": "Workflow task slots used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum by (service, task_queue) (temporal_worker_task_slots_used{worker_type=\"WorkflowWorker\", service=~\"$service\"})",
        "legendFormat": "{{service}} / {{task_queue}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Activity task slots used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (service, task_queue) (temporal_worker_task_slots_used{worker_type=\"ActivityWorker\", service=~\"$service\"})",
        "legendFormat": "{{service}} / {{task_queue}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Workflow task queue polls",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (task_queue) (rate(temporal_workflow_task_queue_poll_succeed_total[$__rate_interval]))", "legendFormat": "{{task_queue}} succeed", "refId": "A" },
        { "expr": "sum by (task_queue) (rate(temporal_workflow_task_queue_poll_empty_total[$__rate_interval]))", "legendFormat": "{{task_queue}} empty", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Long request latency p95 (long polls)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(temporal_long_request_latency_milliseconds_bucket{service=~\"$service\"}[$__rate_interval]))) / 1000",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Sticky cache size",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{
        "expr": "sum by (service) (temporal_sticky_cache_size{service=~\"$service\"})",
        "legendFormat": "{{service}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Sticky cache forced eviction rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "sum by (service) (rate(temporal_sticky_cache_total_forced_eviction_total{service=~\"$service\"}[$__rate_interval]))",
        "legendFormat": "{{service}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["temporal", "worker"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" }, "hide": 0 },
      {
        "name": "service", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=~\"cicd-worker.*|cicd-api\"}, service)", "refresh": 2, "includeAll": true, "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Temporal — Worker Health",
  "uid": "temporal-worker-health",
  "version": 1
}
