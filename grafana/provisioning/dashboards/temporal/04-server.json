{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "description": "Server-side metrics from Temporal frontend/history/matching/worker services. Requires PROMETHEUS_ENDPOINT set on the temporal container.",
  "panels": [
    {
      "type": "row",
      "title": "Frontend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Frontend request rate by operation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [{
        "expr": "sum by (operation) (rate(service_requests{service_name=\"frontend\"}[$__rate_interval]))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Frontend latency p95 by operation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(service_latency_bucket{service_name=\"frontend\"}[$__rate_interval])))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Frontend error rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "targets": [{
        "expr": "sum by (operation, error_type) (rate(service_error_with_type{service_name=\"frontend\"}[$__rate_interval]))",
        "legendFormat": "{{operation}} ({{error_type}})",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 80 } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "History",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "title": "History task processing rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [{
        "expr": "sum by (operation) (rate(task_requests{service_name=\"history\"}[$__rate_interval]))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "History task latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(task_latency_bucket{service_name=\"history\"}[$__rate_interval])))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Matching",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "title": "Matching sync-match rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "description": "Sync match means a poller was waiting when the task arrived — preferred path.",
      "targets": [
        { "expr": "sum(rate(poll_success_sync[$__rate_interval]))", "legendFormat": "sync match", "refId": "A" },
        { "expr": "sum(rate(poll_success[$__rate_interval]))", "legendFormat": "all matched", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Active pollers (per worker)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "description": "Sourced from worker SDK metric temporal_num_pollers; the dev temporal server does not expose a matching-side poller count.",
      "targets": [{
        "expr": "sum by (task_queue, poller_type) (temporal_num_pollers)",
        "legendFormat": "{{task_queue}} ({{poller_type}})",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Persistence",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "title": "Persistence request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [{
        "expr": "sum by (operation) (rate(persistence_requests[$__rate_interval]))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Persistence latency p95 by operation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(persistence_latency_bucket[$__rate_interval])))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Persistence errors by type",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "targets": [{
        "expr": "sum by (operation, error_type) (rate(persistence_error_with_type[$__rate_interval]))",
        "legendFormat": "{{operation}} — {{error_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["temporal", "server"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" }, "hide": 0 }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Temporal — Server",
  "uid": "temporal-server",
  "version": 1
}
