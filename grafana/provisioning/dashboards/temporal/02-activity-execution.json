{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Activity execution latency p95 by activity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, activity_type) (rate(temporal_activity_execution_latency_milliseconds_bucket{activity_type=~\"$activity_type\", task_queue=~\"$task_queue\"}[$__rate_interval]))) / 1000",
        "legendFormat": "{{activity_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Activity end-to-end success latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, activity_type) (rate(temporal_activity_succeed_endtoend_latency_milliseconds_bucket{activity_type=~\"$activity_type\"}[$__rate_interval]))) / 1000",
        "legendFormat": "{{activity_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Activity schedule-to-start latency p95 (queue wait)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "High values indicate worker shortage or task-queue starvation.",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, task_queue) (rate(temporal_activity_schedule_to_start_latency_milliseconds_bucket[$__rate_interval]))) / 1000",
        "legendFormat": "{{task_queue}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Activity execution latency distribution",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "sum by (le) (rate(temporal_activity_execution_latency_milliseconds_bucket{activity_type=~\"$activity_type\"}[$__rate_interval]))",
        "format": "heatmap",
        "legendFormat": "{{le}}",
        "refId": "A"
      }],
      "options": { "calculate": false, "yAxis": { "unit": "ms" } }
    },
    {
      "title": "Activity failures by reason",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "expr": "sum by (activity_type, failure_reason) (rate(temporal_activity_execution_failed_total[$__rate_interval]))",
        "legendFormat": "{{activity_type}} — {{failure_reason}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "title": "Activity cancellations",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "expr": "sum by (activity_type) (rate(temporal_activity_execution_canceled_total[$__rate_interval]))",
        "legendFormat": "{{activity_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Idle worker polls (poll-no-task)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "description": "Steady non-zero values mean a worker is idling on this task queue.",
      "targets": [{
        "expr": "sum by (task_queue) (rate(temporal_activity_poll_no_task_total[$__rate_interval]))",
        "legendFormat": "{{task_queue}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Top activities by execution rate",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{
        "expr": "topk(10, sum by (activity_type) (rate(temporal_activity_execution_latency_milliseconds_count[$__rate_interval])))",
        "legendFormat": "{{activity_type}}",
        "refId": "A"
      }],
      "options": { "displayMode": "lcd", "orientation": "horizontal", "showUnfilled": true },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "continuous-BlPu" } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["temporal", "activity"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" }, "hide": 0 },
      {
        "name": "task_queue", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(temporal_activity_execution_latency_milliseconds_count, task_queue)", "refresh": 2, "includeAll": true, "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "activity_type", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(temporal_activity_execution_latency_milliseconds_count{task_queue=~\"$task_queue\"}, activity_type)", "refresh": 2, "includeAll": true, "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Temporal — Activity Execution",
  "uid": "temporal-activity-execution",
  "version": 1
}
