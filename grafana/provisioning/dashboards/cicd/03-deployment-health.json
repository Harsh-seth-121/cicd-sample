{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "DEV deploy throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum by (status) (rate(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Dev\"}[$__rate_interval]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] }
    },
    {
      "title": "QA deploy throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum by (status) (rate(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Qa\"}[$__rate_interval]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] }
    },
    {
      "title": "Deploy duration p95 by environment",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(cicd_stage_duration_seconds_bucket{stage=\"DeployToEnvironment\"}[$__rate_interval])))",
        "legendFormat": "{{environment}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Verification duration p95 by environment",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(cicd_stage_duration_seconds_bucket{stage=\"VerifyEnvironment\"}[$__rate_interval])))",
        "legendFormat": "{{environment}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Verification failure rate by environment",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "expr": "sum by (environment) (rate(cicd_activity_executed_activities_total{activity=\"VerifyEnvironment\", status=~\"failed|canceled\"}[$__rate_interval])) / clamp_min(sum by (environment) (rate(cicd_activity_executed_activities_total{activity=\"VerifyEnvironment\"}[$__rate_interval])), 0.0001)",
        "legendFormat": "{{environment}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Deploys today (DEV vs QA)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Dev\", status=\"success\"}[1d]))", "legendFormat": "DEV success", "refId": "A" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Qa\", status=\"success\"}[1d]))", "legendFormat": "QA success", "refId": "B" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", status=\"failed\"}[1d]))", "legendFormat": "Deploy failures", "refId": "C" }
      ],
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "title": "Recent deploy failures (1h)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [{
        "expr": "topk(20, sum by (environment, activity) (increase(cicd_activity_executed_activities_total{status=~\"failed|canceled\", activity=~\"DeployToEnvironment|VerifyEnvironment\"}[1h])))",
        "format": "table",
        "instant": true,
        "refId": "A"
      }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "service": true }, "renameByName": { "Value": "count (1h)" } } }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cicd", "deploy"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" }, "hide": 0 }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CI/CD — Deployment Health",
  "uid": "cicd-deployment-health",
  "version": 1
}
