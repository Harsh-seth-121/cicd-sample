{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Pipeline Overview", "type": "dashboards", "tags": ["cicd"], "asDropdown": true, "includeVars": true, "keepTime": true }
  ],
  "panels": [
    {
      "title": "Activity executions by stage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum by (activity) (rate(cicd_activity_executed_activities_total{task_queue=~\"$task_queue\"}[$__rate_interval]))",
        "legendFormat": "{{activity}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Activity outcome mix",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum by (status) (rate(cicd_activity_executed_activities_total{task_queue=~\"$task_queue\"}[$__rate_interval]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "canceled" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      }
    },
    {
      "title": "Top failed activities (1h)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "topk(10, sum by (activity) (increase(cicd_activity_executed_activities_total{status=\"failed\"}[1h])))",
        "legendFormat": "{{activity}}",
        "refId": "A"
      }],
      "options": { "displayMode": "lcd", "orientation": "horizontal", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      }
    },
    {
      "title": "Stage failure rate (canceled+failed share)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "sum by (activity) (rate(cicd_activity_executed_activities_total{status=~\"failed|canceled\"}[$__rate_interval])) / clamp_min(sum by (activity) (rate(cicd_activity_executed_activities_total[$__rate_interval])), 0.0001)",
        "legendFormat": "{{activity}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Stage duration p95 by activity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(cicd_stage_duration_seconds_bucket[$__rate_interval])))",
        "legendFormat": "{{stage}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "title": "Stage duration heatmap (all stages)",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "expr": "sum by (le) (rate(cicd_stage_duration_seconds_bucket[$__rate_interval]))",
        "format": "heatmap",
        "legendFormat": "{{le}}",
        "refId": "A"
      }],
      "options": { "calculate": false, "yAxis": { "unit": "s" } }
    },
    {
      "title": "Pipeline funnel (executions per stage, 1h)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"NormalizeMetadata\"}[1h]))", "legendFormat": "1. Ingress", "refId": "A" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"Build\"}[1h]))", "legendFormat": "2. Build", "refId": "B" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"IntegrationTests\"}[1h]))", "legendFormat": "3. Integration tests", "refId": "C" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"RequiredScans\"}[1h]))", "legendFormat": "4. Scans", "refId": "D" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"ComputeVersion\"}[1h]))", "legendFormat": "5. Version", "refId": "E" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"PushImage\"}[1h]))", "legendFormat": "6. Publish", "refId": "F" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Dev\"}[1h]))", "legendFormat": "7. Deploy DEV", "refId": "G" },
        { "expr": "sum(increase(cicd_activity_executed_activities_total{activity=\"DeployToEnvironment\", environment=\"Qa\"}[1h]))", "legendFormat": "8. Deploy QA", "refId": "H" }
      ],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cicd"],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" }, "hide": 0 },
      {
        "name": "task_queue", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(cicd_activity_executed_activities_total, task_queue)", "refresh": 2, "includeAll": true, "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CI/CD — Stage Drilldown",
  "uid": "cicd-stage-drilldown",
  "version": 1
}
